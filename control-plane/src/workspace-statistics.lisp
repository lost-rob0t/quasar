(in-package #:quasar.store)

(dolist (code '("workspace.statistics-migration-required" "workspace.statistics-invalid"))
  (pushnew code quasar.protocol::+error-codes+ :test #'string=))

(defun %statistics-key (workspace-id suffix)
  (concatenate 'string (%workspace-prefix workspace-id) "statistics-v1/" suffix))
(defun %statistics-put (db key value)
  (when (or (> (%utf8-length key) 500)
            (> (%utf8-length (quasar.protocol:encode value)) 8192))
    (%query-error "workspace.statistics-invalid" "Statistics key or record exceeds its bounded representation."))
  (%put-record db key value))
(defun %statistics-ready-p (db ws)
  (eql 1 (quasar.protocol:json-value (tek9:fetch* db (%statistics-key ws "ready")) "version")))
(defun %mark-statistics-ready (db ws)
  (%statistics-put db (%statistics-key ws "ready") (quasar.protocol:json-object (cons "version" 1))))
(defun %statistics-descending (count)
  (unless (and (integerp count) (<= 0 count) (<= (integer-length count) 256))
    (%query-error "workspace.statistics-invalid" "Statistics counter is outside the exact supported range."))
  (format nil "~64,'0X" (- (1- (ash 1 256)) count)))
(defun %statistics-truthy (value)
  (not (or (eq value :null) (eq value :false)
           (and (numberp value) (zerop value)) (equal value ""))))
(defun %statistics-legacy (document)
  (quasar.protocol:json-value (quasar.protocol:json-value document "extensions") "quasarLegacy090"))
(defun %statistics-js-string (value)
  (cond ((eq value :null) "null")
        ((member value '(t :true :t)) "true") ((eq value :false) "false")
        ((stringp value) value)
        ((quasar.protocol:array-p value)
         (format nil "~{~A~^,~}" (mapcar (lambda (item) (if (or (null item) (eq item :null)) "" (%statistics-js-string item))) (quasar.workspace:array-elements value))))
        ((consp value) "[object Object]") (t (princ-to-string value))))
(defun %statistics-reviewed-p (document)
  ;; toLegacyUiDocument preserves this top-level compatibility field; canonical
  ;; verificationStatus/verifiedAt are DATA fields, not reviewState's input.
  (let* ((verification (quasar.protocol:json-value (%statistics-legacy document) "verification"))
         (verified (quasar.protocol:json-value verification "verified"))
         (status (quasar.protocol:json-value verification "status" :null))
         (normalized (substitute #\- #\Space (substitute #\- #\_ (string-downcase
                       (string-trim (mapcar #'code-char '(9 10 11 12 13 32 160 5760 8192 8193 8194 8195 8196 8197 8198 8199 8200 8201 8202 8232 8233 8239 8287 12288 65279))
                                    (if (%statistics-truthy status) (%statistics-js-string status) "")))))))
    (cond ((member verified '(t :true :t)) t) ((eq verified :false) nil)
          ((member normalized '("reviewed" "verified" "approved" "accepted" "confirmed" "complete" "completed") :test #'equal) t)
          (t (%statistics-truthy (quasar.protocol:json-value verification "last_reviewed_at" :null))))))

;; Use the same pinned workflow authority as the presentation adapter. Only the
;; few label/endpoint fields needed here are projected, never a second document.
(defvar *statistics-workflow-mappings* nil)
(defun %statistics-mappings ()
  (or *statistics-workflow-mappings*
      (setf *statistics-workflow-mappings*
            (quasar.protocol:json-value
             (jsown:parse (uiop:read-file-string
                          (merge-pathnames "../supported-workflow-mappings.json"
                                           (starintel.canonical:schema-path)))) "contracts"))))
(defun %statistics-snake (name)
  (with-output-to-string (out)
    (loop for c across name do (if (upper-case-p c) (format out "_~A" (char-downcase c)) (write-char c out)))))
(defun %statistics-data-field (document wanted)
  (let* ((dtype (quasar.protocol:json-value document "dtype"))
         (mapping (quasar.protocol:json-value (quasar.protocol:json-value (%statistics-mappings) dtype) "fields"))
         (value (quasar.protocol:json-value (quasar.protocol:json-value (%statistics-legacy document) "data") wanted :null))
         (base (gethash "properties" (gethash "Document" (gethash "$defs" (starintel.canonical:load-schema))))))
    (dolist (field (cdr document))
      (let* ((name (car field))
             (inverse (car (find name (cdr mapping) :key #'cdr :test #'equal)))
             (target (cond (inverse inverse)
                           ((member name '("id" "dtype" "dataset" "schemaVersion" "extensions" "rev" "createdAt" "updatedAt"
                                           "sources" "tags" "aliases" "labels" "language" "notes" "provenance" "deleted") :test #'equal) nil)
                           ((and (equal dtype "relation") (equal name "source")) "subject")
                           ((and (equal dtype "relation") (equal name "destination")) "object")
                           ((and (equal dtype "relation") (equal name "direction")) "direction")
                           ((and mapping (gethash name base)) nil)
                           (t (%statistics-snake name)))))
        (when (equal target wanted) (setf value (cdr field)))))
    value))
(defun %statistics-label (document)
  (let* ((legacy (%statistics-legacy document))
         (auto (quasar.protocol:json-value (quasar.protocol:json-value document "extensions") "auto_dig"))
         (title (if (and (equal "target" (quasar.protocol:json-value document "dtype"))
                         (equal "tip" (quasar.protocol:json-value document "targetType"))
                         (%statistics-truthy (quasar.protocol:json-value auto "local_tip_id" :null)))
                    (format nil "Tip: ~A" (%statistics-js-string (quasar.protocol:json-value auto "title" "undefined")))
                    (quasar.protocol:json-value legacy "title" :null))))
    (let ((label (loop for value in (cons title (mapcar (lambda (field) (%statistics-data-field document field))
                                                       '("display_label" "canonical_name" "display_name" "full_name" "name" "domain" "url" "target")))
                       when (%statistics-truthy value) return value
                       finally (return (quasar.protocol:json-value document "id")))))
      (unless (stringp label) (%query-error "workspace.statistics-invalid" "Reviewed node labels must be strings."))
      label)))

(defun %statistics-endpoint (value)
  (if (stringp value) value
      (loop for field in '("id" "entity_id" "document_id" "external_id")
            for id = (quasar.protocol:json-value value field :null)
            when (%statistics-truthy id) return id)))
(defun %statistics-endpoints (value)
  (remove-if-not (lambda (id) (and id (%statistics-truthy id)))
                 (mapcar #'%statistics-endpoint
                         (if (quasar.protocol:array-p value) (quasar.workspace:array-elements value) (list value)))))
(defun %statistics-node-key (ws id) (%statistics-key ws (concatenate 'string "node/" (%key-part id))))
(defun %statistics-ref-prefix (ws id) (%statistics-key ws (concatenate 'string "ref/" (%key-part id) "/")))
(defun %statistics-rank-prefix (ws) (%statistics-key ws "rank/"))
(defun %statistics-node-rank-key (ws row)
  (when row
    (concatenate 'string (%statistics-rank-prefix ws)
                 (%statistics-descending (quasar.protocol:json-value row "count" 0)) "/"
                 (quasar.protocol:json-value row "order"))))

(defun %statistics-node-delta (db ws id delta &key reference owner label)
  (unless (and (stringp id) (plusp (length id)))
    (%query-error "workspace.statistics-invalid" "Reviewed graph endpoints must be nonempty string identifiers."))
  (when (and owner (plusp delta) (not (stringp label)))
    (%query-error "workspace.statistics-invalid" "Reviewed node labels must be strings."))
  (let* ((key (%statistics-node-key ws id)) (old (tek9:fetch* db key))
         (degree (+ (quasar.protocol:json-value old "count" 0) (if reference delta 0)))
         (owned (if owner (plusp delta) (member (quasar.protocol:json-value old "owned") '(t :true :t))))
         (node-label (if owner (and owned label) (quasar.protocol:json-value old "label")))
         (prefix (%statistics-ref-prefix ws id)))
    (when old (tek9:delete-document db (%statistics-node-rank-key ws old)))
    (when reference
      (let ((ref-key (concatenate 'string prefix reference)))
        (if (plusp delta) (%statistics-put db ref-key (quasar.protocol:json-object (cons "order" reference)))
            (tek9:delete-document db ref-key))))
    (when (minusp degree) (%query-error "workspace.statistics-invalid" "Missing graph degree accounting."))
    (let* ((first-ref (unless owned (first (%bounded-range db prefix :limit 1))))
           (order (if owned (concatenate 'string "0/" (%key-part id))
                      (and first-ref (quasar.protocol:json-value (cdr first-ref) "order")))))
      (if order
          (let ((row (quasar.protocol:json-object (cons "id" id) (cons "count" degree) (cons "order" order)
                                                 (cons "owned" (if owned t :false)) (cons "label" (if owned node-label id)))))
            (%statistics-put db key row)
            (%statistics-put db (%statistics-node-rank-key ws row)
                             (quasar.protocol:json-object (cons "id" id) (cons "count" degree)
                                                         (cons "label" (if owned node-label id)))))
          (tek9:delete-document db key)))))

(defun %statistics-graph-delta (db ws document delta)
  (let* ((id (quasar.protocol:json-value document "id"))
         (relation (equal "relation" (quasar.protocol:json-value document "dtype")))
         (ordinal 0))
    (labels ((endpoint (node phase)
               (when (>= ordinal (ash 1 64)) (%query-error "workspace.statistics-invalid" "Too many endpoint occurrences."))
               (%statistics-node-delta db ws node delta
                                       :reference (format nil "~D/~A/~16,'0X" phase (%key-part id) ordinal))
               (incf ordinal)))
      (if relation
          (let* ((subject (%statistics-data-field document "subject"))
                 (object (%statistics-data-field document "object"))
                 (sources (%statistics-endpoints (if (%statistics-truthy subject) subject (%statistics-data-field document "source"))))
                 (targets (%statistics-endpoints (if (%statistics-truthy object) object (%statistics-data-field document "target")))))
            (dolist (source sources) (dolist (target targets) (endpoint source 1) (endpoint target 1))))
          (progn
            (%statistics-node-delta db ws id delta :owner t :label (%statistics-label document))
            (dolist (target (let ((related (quasar.protocol:json-value (%statistics-legacy document) "related_ids" :null)))
                              (when (%statistics-truthy related)
                                (unless (quasar.protocol:array-p related)
                                  (%query-error "workspace.statistics-invalid" "Reviewed related_ids must be an array."))
                                (quasar.workspace:array-elements related))))
              ;; Source degree also gets a witness; owner order always wins.
              (endpoint id 2) (endpoint target 2)))))))

(defun %statistics-empty-summary ()
  (apply #'quasar.protocol:json-object
         (append (mapcar (lambda (key) (cons key 0))
                         '("documents" "reviewedDocuments" "unreviewedDocuments" "reviewedEntities" "reviewedRelations"
                           "reviewedEvents" "reviewedInvestigationTargets"))
                 (list (cons "reviewedByDtype" (quasar.protocol:empty-object))
                       (cons "unreviewedByDtype" (quasar.protocol:empty-object))))))
(defun %statistics-increment (object field delta &optional remove-zero)
  (let ((count (+ delta (quasar.protocol:json-value object field 0))))
    (%statistics-descending count)
    (if (and remove-zero (zerop count))
        (setf (cdr object) (remove field (cdr object) :key #'car :test #'equal))
        (quasar.protocol:object-set object field count))
    count))
(defun %statistics-dataset-rank-key (ws name count)
  ;; UTF-8 lexical name order; the name is last and therefore needs no escaping.
  (concatenate 'string (%statistics-key ws "datasets/") (%statistics-descending count) "/" name))
(defun %statistics-dataset-delta (db ws name delta)
  (let* ((key (%statistics-key ws (concatenate 'string "dataset/" (%key-part name))))
         (old (quasar.protocol:json-value (tek9:fetch* db key) "documentCount" 0))
         (count (+ old delta)))
    (when (plusp old) (tek9:delete-document db (%statistics-dataset-rank-key ws name old)))
    (%statistics-descending count)
    (if (zerop count) (tek9:delete-document db key)
        (let ((row (quasar.protocol:json-object (cons "name" name) (cons "documentCount" count))))
          (%statistics-put db key row)
          (%statistics-put db (%statistics-dataset-rank-key ws name count) row)))))
(defun %statistics-document-delta (db ws document delta)
  (when document
    (let* ((key (%statistics-key ws "summary"))
           (summary (or (tek9:fetch* db key) (%statistics-empty-summary)))
           (reviewed (%statistics-reviewed-p document))
           (dtype (quasar.protocol:json-value document "dtype")))
      (%statistics-increment summary "documents" delta)
      (%statistics-increment summary (if reviewed "reviewedDocuments" "unreviewedDocuments") delta)
      (%statistics-increment (quasar.protocol:json-value summary (if reviewed "reviewedByDtype" "unreviewedByDtype")) dtype delta t)
      (when reviewed
        (let ((metric (cond ((member dtype '("entity" "person" "org") :test #'equal) "reviewedEntities")
                            ((equal dtype "relation") "reviewedRelations")
                            ((member dtype '("event" "meeting") :test #'equal) "reviewedEvents")
                            ((member dtype '("investigation-target" "target") :test #'equal) "reviewedInvestigationTargets"))))
          (when metric (%statistics-increment summary metric delta)))
        (%statistics-dataset-delta db ws (let ((name (quasar.protocol:json-value document "dataset" :null)))
                                          (if (%statistics-truthy name) name "unknown")) delta)
        (%statistics-graph-delta db ws document delta))
      (%statistics-put db key summary))))
(defun %maintain-statistics-document (db ws old new)
  (unless (tek9:fetch* db (%workspace-meta-key ws)) (%mark-statistics-ready db ws))
  (when (%statistics-ready-p db ws)
    (%statistics-document-delta db ws old -1)
    (%statistics-document-delta db ws new 1)))

(defun migrate-workspace-statistics (store workspace-id &key expected-revision)
  "Explicit atomic maintenance; no startup/read path invokes this scan."
  (let ((db (tek9-store-database store)))
    (tek9:with-write-transaction (db)
      (let ((revision (quasar.protocol:json-value (%read-meta db workspace-id) "revision" 0))
            (start nil) (prefix (%document-prefix workspace-id)) (count 0))
        (when (and expected-revision (not (eql revision expected-revision)))
          (%query-error "query.stale-cursor" "Workspace changed before statistics migration."))
        (%delete-prefix-bounded db (%statistics-key workspace-id ""))
        (loop for row = (first (%bounded-range db prefix :start start :limit 1)) while row
              do (%statistics-document-delta db workspace-id (cdr row) 1)
                 (incf count) (setf start (car row)))
        (let ((hook (tek9-store-failure-hook store))) (when hook (funcall hook :before-statistics-ready)))
        (%mark-statistics-ready db workspace-id)
        (quasar.protocol:json-object (cons "version" 1) (cons "revision" revision) (cons "documentCount" count))))))

(defgeneric workspace-statistics (store workspace-id request))
(defmethod workspace-statistics ((store workspace-store) workspace-id request)
  (declare (ignore workspace-id request))
  (%query-error "query.unsupported-store" "Authoritative statistics require Tek9."))
(defmethod workspace-statistics ((store tek9-store) workspace-id request)
  (let ((section (quasar.protocol:json-value request "section")) (db (tek9-store-database store)))
    (unless (member section '("summary" "datasets") :test #'equal) (%query-error "query.invalid" "Unknown statistics section."))
    (%query-keys request (if (equal section "summary") '("section" "expectedRevision" "byteLimit")
                            '("section" "expectedRevision" "byteLimit" "limit" "cursor" "scanLimit" "deadlineMs")))
    (tek9:with-read-transaction (db)
      (let* ((stored (tek9:fetch* db (%workspace-meta-key workspace-id)))
             (revision (quasar.protocol:json-value stored "revision" 0)))
        (when (and stored (not (%statistics-ready-p db workspace-id)))
          (%query-error "workspace.statistics-migration-required" "Run explicit workspace statistics migration before loading this dashboard."))
        (unless (eql revision (quasar.protocol:json-value request "expectedRevision" revision))
          (%query-error "query.stale-cursor" "Workspace changed; reload statistics."))
        (if (equal section "datasets")
            (%bounded-graph-page db workspace-id request revision
                                 (quasar.protocol:json-object (cons "kind" "workspace-statistics-datasets.v1"))
                                 (%statistics-key workspace-id "datasets/") "workspace-statistics-datasets.v1" nil)
            (let* ((bytes (%query-integer request "byteLimit" *query-max-bytes* 32768 *query-max-bytes*))
                   (summary (or (tek9:fetch* db (%statistics-key workspace-id "summary")) (%statistics-empty-summary)))
                   (total (quasar.protocol:json-value summary "documents"))
                   (reviewed (quasar.protocol:json-value summary "reviewedDocuments")))
              (quasar.protocol:object-set summary "reviewPercent" (if (zerop total) 0 (floor (+ (* 200 reviewed) total) (* 2 total))))
              (quasar.protocol:object-set summary "topConnected"
                                         (cons :array (mapcar #'cdr (%bounded-range db (%statistics-rank-prefix workspace-id) :limit 12))))
              (let ((result (quasar.protocol:json-object (cons "revision" revision) (cons "projection" "workspace-statistics.v1")
                                                        (cons "statistics" summary))))
                (when (> (%utf8-length (quasar.protocol:encode result)) (- bytes 16384))
                  (%query-error "query.record-too-large" "Statistics summary exceeds response byte budget."))
                result)))))))
