(in-package #:quasar.store)

(dolist (code '("dataset.catalog-migration-required" "dataset.catalog-invalid"))
  (pushnew code quasar.protocol::+error-codes+ :test #'string=))

(defun %dataset-prefix (workspace-id)
  (concatenate 'string (%workspace-prefix workspace-id) "dataset-catalog-v1/"))
(defun %dataset-key (workspace-id name)
  (concatenate 'string (%dataset-prefix workspace-id) (%key-part name)))
(defun %dataset-ready-key (workspace-id)
  (concatenate 'string (%workspace-prefix workspace-id) "dataset-catalog-version"))
(defun %dataset-time-prefix (workspace-id name)
  (format nil "~Adataset-time-v1/~A/" (%workspace-prefix workspace-id) (%key-part name)))
(defun %dataset-time-key (workspace-id name time)
  ;; Fixed-width complemented unsigned time sorts newest first. 256 bits is
  ;; intentionally far beyond ordinary Unix seconds; never round through floats.
  (unless (and (integerp time) (<= 0 time) (<= (integer-length time) 256))
    (%query-error "dataset.catalog-invalid" "Dataset timestamps must be nonnegative integers of at most 256 bits."))
  (format nil "~A~64,'0X" (%dataset-time-prefix workspace-id name) (- (1- (ash 1 256)) time)))
(defun %mark-dataset-ready (database workspace-id)
  (%put-record database (%dataset-ready-key workspace-id) (quasar.protocol:json-object (cons "version" 1))))
(defun %dataset-ready-p (database workspace-id)
  (eql 1 (quasar.protocol:json-value (tek9:fetch* database (%dataset-ready-key workspace-id)) "version")))
(defun %put-dataset-record (database key row)
  (when (> (%utf8-length (quasar.protocol:encode row)) 8192)
    (%query-error "dataset.catalog-invalid" "Dataset summary exceeds 8192 UTF-8 bytes."))
  (%put-record database key row))

(defun %dataset-time-delta (database workspace-id name time delta)
  (unless (or (null time) (eq time :null))
    (let* ((key (%dataset-time-key workspace-id name time))
           (old (tek9:fetch* database key))
           (count (+ delta (quasar.protocol:json-value old "count" 0))))
      (when (minusp count) (%query-error "dataset.catalog-invalid" "Missing dataset timestamp accounting."))
      (if (zerop count)
          (tek9:delete-document database key)
          (%put-dataset-record database key (quasar.protocol:json-object (cons "count" count) (cons "time" time)))))))

(defun %dataset-document-delta (database workspace-id document delta)
  (when document
    (let* ((name (quasar.protocol:json-value document "dataset"))
           (dtype (quasar.protocol:json-value document "dtype"))
           (time (quasar.protocol:json-value document "updatedAt" :null)))
      (unless (and (stringp name) (stringp dtype))
        (%query-error "dataset.catalog-invalid" "Dataset and dtype must be canonical strings."))
      (let* ((key (%dataset-key workspace-id name))
             (old (tek9:fetch* database key))
             (count (+ delta (quasar.protocol:json-value old "documentCount" 0)))
             (types (quasar.protocol:clone-json (quasar.protocol:json-value old "typeCounts" (quasar.protocol:empty-object))))
             (type-count (+ delta (quasar.protocol:json-value types dtype 0))))
        (when (or (minusp count) (minusp type-count))
          (%query-error "dataset.catalog-invalid" "Missing dataset document accounting."))
        (%dataset-time-delta database workspace-id name time delta)
        (if (zerop type-count)
            (setf (cdr types) (remove dtype (cdr types) :key #'car :test #'equal))
            (quasar.protocol:object-set types dtype type-count))
        (if (zerop count)
            (tek9:delete-document database key)
            (let ((newest (first (%bounded-range database (%dataset-time-prefix workspace-id name) :limit 1))))
              (%put-dataset-record
               database key (quasar.protocol:json-object
                             (cons "name" name) (cons "documentCount" count)
                             (cons "typeCounts" types)
                             (cons "updatedAt" (if newest (quasar.protocol:json-value (cdr newest) "time") :null))))))))))

(defun %maintain-dataset-document (database workspace-id old new)
  ;; Do not publish partial summaries of old workspaces. Explicit migration is
  ;; the only path that scans legacy documents; new workspaces start indexed.
  (unless (tek9:fetch* database (%workspace-meta-key workspace-id))
    (%mark-dataset-ready database workspace-id))
  (when (%dataset-ready-p database workspace-id)
    (%dataset-document-delta database workspace-id old -1)
    (%dataset-document-delta database workspace-id new 1)))

(defun %put-cataloged-document (database workspace-id id document)
  (let ((key (%document-key workspace-id id)))
    (%maintain-statistics-document database workspace-id (tek9:fetch* database key) document)
    (%maintain-dataset-document database workspace-id (tek9:fetch* database key) document)
    (%put-record database key document)))
(defun %delete-cataloged-document (database workspace-id id)
  (let ((key (%document-key workspace-id id)))
    (%maintain-statistics-document database workspace-id (tek9:fetch* database key) nil)
    (%maintain-dataset-document database workspace-id (tek9:fetch* database key) nil)
    (tek9:delete-document database key)))

(defun migrate-dataset-catalog (store workspace-id &key expected-revision)
  "Explicit atomic maintenance rebuild; never invoked by startup or reads."
  (let ((database (tek9-store-database store)))
    (tek9:with-write-transaction (database)
      (let ((revision (quasar.protocol:json-value (%read-meta database workspace-id) "revision" 0))
            (count 0) (start nil) (prefix (%document-prefix workspace-id)))
        (when (and expected-revision (not (eql expected-revision revision)))
          (%query-error "query.stale-cursor" "Workspace changed before dataset migration."))
        (%delete-prefix-bounded database (%dataset-prefix workspace-id))
        (%delete-prefix-bounded database (concatenate 'string (%workspace-prefix workspace-id) "dataset-time-v1/"))
        (loop for row = (first (%bounded-range database prefix :start start :limit 1))
              while row do (%dataset-document-delta database workspace-id (cdr row) 1)
                (incf count) (setf start (car row)))
        (let ((hook (tek9-store-failure-hook store)))
          (when hook (funcall hook :before-dataset-catalog-ready)))
        (%mark-dataset-ready database workspace-id)
        (quasar.protocol:json-object (cons "version" 1) (cons "revision" revision) (cons "documentCount" count))))))

(defgeneric dataset-catalog-page (store workspace-id request))
(defmethod dataset-catalog-page ((store workspace-store) workspace-id request)
  (declare (ignore workspace-id request))
  (%query-error "query.unsupported-store" "Bounded dataset reads require Tek9."))
(defmethod dataset-catalog-page ((store tek9-store) workspace-id request)
  (%query-keys request '("limit" "byteLimit" "scanLimit" "deadlineMs" "cursor" "expectedRevision"))
  (let ((database (tek9-store-database store)))
    (tek9:with-read-transaction (database)
      (let* ((stored-meta (tek9:fetch* database (%workspace-meta-key workspace-id)))
             (meta (%read-meta database workspace-id)))
        (when (and stored-meta (not (%dataset-ready-p database workspace-id)))
          (%query-error "dataset.catalog-migration-required" "Run explicit dataset catalog migration before reading summaries."))
        (%bounded-graph-page
         database workspace-id request (quasar.protocol:json-value meta "revision" 0)
         (quasar.protocol:json-object (cons "kind" "dataset-catalog.v1"))
         (%dataset-prefix workspace-id) "dataset-catalog.v1" nil
         (lambda (row)
           (quasar.protocol:json-object
            (cons "name" (quasar.protocol:json-value row "name"))
            (cons "documentCount" (quasar.protocol:json-value row "documentCount"))
            (cons "types" (cons :array (sort (mapcar #'car (cdr (quasar.protocol:json-value row "typeCounts"))) #'string<)))
            (cons "updatedAt" (quasar.protocol:json-value row "updatedAt" :null)))))))))
