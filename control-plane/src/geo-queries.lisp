(in-package #:quasar.store)

(defun %geo-database (store workspace)
  (unless (typep store 'tek9-store)
    (%query-error "query.unsupported-store" "Geo requires Tek9."))
  (let ((database (tek9-store-database store)))
    (unless (or (%geo-ready-p database workspace)
                (null (%bounded-range database (%document-prefix workspace) :limit 1)))
      (%query-error "geo.index-required" "Run the explicit Geo index rebuild for this workspace."))
    database))

(defun %geo-number (value minimum maximum)
  (unless (handler-case
              (and (realp value) (<= minimum value maximum)
                   (or (not (rationalp value))
                       (and (<= (integer-length (numerator value)) 256)
                            (<= (integer-length (denominator value)) 256))))
            (error () nil))
    (%query-error "geo.invalid" "Coordinates must be finite WGS84 numbers."))
  (coerce value 'double-float))

(defun %geo-bounds (request)
  (let ((bounds (quasar.workspace:array-elements
                 (quasar.protocol:ensure-array (json-value request "bbox") "bbox" "geo.invalid"))))
    (unless (= 4 (length bounds)) (%query-error "geo.invalid" "bbox is [west,south,east,north]."))
    (destructuring-bind (w s e n) bounds
      (setf w (%geo-number w -180 180) e (%geo-number e -180 180)
            s (%geo-number s -90 90) n (%geo-number n -90 90))
      (when (> s n) (%query-error "geo.invalid" "south must not exceed north."))
      (list w s e n))))

(defun %geo-grid (bounds depth)
  (destructuring-bind (w s e n) bounds
    (multiple-value-bind (x0 y0) (%geo-xy w s depth)
      (multiple-value-bind (x1 y1) (%geo-xy e n depth)
        (let* ((width (ash 1 depth))
               (ranges (if (<= w e)
                           (if (and (= e 180d0) (plusp x0))
                               (list (cons 0 0) (cons x0 x1))
                               (list (cons x0 x1)))
                           ;; Merge overlap at coarse depths (e.g. depth zero).
                           (if (<= x0 (1+ x1)) (list (cons 0 (1- width)))
                               (list (cons 0 x1) (cons x0 (1- width))))))
               (count (* (1+ (- y1 y0)) (loop for (a . b) in ranges sum (1+ (- b a))))))
          (values ranges y0 y1 count))))))

(defun %geo-cells (bounds depth)
  (multiple-value-bind (ranges y0 y1 count) (%geo-grid bounds depth)
    (when (> count +geo-cell-budget+)
      (%query-error "geo.zoom-in" "Zoom in before requesting individual points (at most 256 index cells)."))
    (loop for (a . b) in ranges append
          (loop for x from a to b append (loop for y from y0 to y1 collect (cons x y))))))

(defun %geo-cell-bounds (depth x y)
  (let ((width (/ 360d0 (ash 1 depth))) (height (/ 180d0 (ash 1 depth))))
    (list (- (* x width) 180d0) (- (* y height) 90d0)
          (- (* (1+ x) width) 180d0) (- (* (1+ y) height) 90d0))))

(defun %geo-contains (bounds point)
  (destructuring-bind (w s e n) bounds
    (let ((lon (json-value point "longitude")) (lat (json-value point "latitude")))
      (and (<= s lat n)
           (or (if (<= w e) (<= w lon e) (or (>= lon w) (<= lon e)))
               (and (= lon -180d0) (= e 180d0)))))))

(defun %geo-revision (database workspace)
  (json-value (%read-meta database workspace) "revision" 0))

(defun %geo-scope (kind &rest pairs)
  (apply #'quasar.protocol:json-object (cons (cons "query" kind) pairs)))

(defun %geo-result (revision rows complete cursor scanned reason began &optional (field "points"))
  (let ((result (quasar.protocol:json-object
                 (cons "revision" revision) (cons "projection" "quasar.geo.point.v1")
                 (cons field (cons :array rows))
                 (cons "complete" (if complete t :false)) (cons "cursor" (or cursor :null))
                 (cons "performance" (quasar.protocol:json-object
                                      (cons "scanned" scanned) (cons "stopReason" reason)
                                      (cons "elapsedMs" (ceiling (* 1000 (- (funcall *query-clock*) began))
                                                                   internal-time-units-per-second)))))))
    (when (> (%utf8-length (quasar.protocol:encode result)) *query-max-bytes*)
      (%query-error "query.record-too-large" "Geo response exceeds its byte budget."))
    result))

(defun geo-viewport (store workspace request)
  (%query-keys request '("bbox" "zoom"))
  (let* ((bounds (%geo-bounds request)) (zoom (%query-integer request "zoom" 0 0 22))
         (depth (min +geo-depth+ (+ zoom 2))) (began (funcall *query-clock*))
         (database (if (typep store 'tek9-store) (tek9-store-database store)
                       (%query-error "query.unsupported-store" "Geo requires Tek9."))))
    (loop while (> (nth-value 3 (%geo-grid bounds depth)) +geo-cell-budget+) do (decf depth))
    (tek9:with-read-transaction (database)
      (%geo-database store workspace)
      (let ((cells (%geo-cells bounds depth)) (features nil) (reads 0))
        (dolist (cell cells)
          (let* ((x (car cell)) (y (cdr cell))
                 (count (json-value (tek9:fetch* database (%geo-cell-key workspace depth x y)) "count" 0)))
            (incf reads)
            (when (plusp count)
              (push (quasar.protocol:json-object
                     (cons "id" (format nil "~D/~D/~D" depth x y))
                     (cons "count" count)
                     (cons "bbox" (cons :array (%geo-cell-bounds depth x y)))) features))))
        (let ((result (%geo-result (%geo-revision database workspace) (nreverse features) t nil reads "complete" began "cells")))
          (quasar.protocol:object-set result "depth" depth)
          (quasar.protocol:object-set result "countSemantics" "direct-point-anchors-in-whole-cell")
          result)))))

(defun geo-points (store workspace request)
  (%query-keys request '("bbox" "limit" "cursor" "scanLimit" "deadlineMs"))
  (let* ((bounds (%geo-bounds request)) (cells (%geo-cells bounds +geo-depth+))
         (limit (%query-integer request "limit" 50 1 100))
         (scan-limit (%query-integer request "scanLimit" 1000 1 1000))
         (deadline (%query-integer request "deadlineMs" 50 1 50))
         ;; JSON rational re-encoding in JSOWN rounds to single floats. String
         ;; scopes preserve cursor identity at sub-millimetre precision.
         (scope (%geo-scope "points" (cons "bbox" (cons :array (mapcar (lambda (n) (format nil "~,12F" n)) bounds)))))
         (began (funcall *query-clock*))
         (database (if (typep store 'tek9-store) (tek9-store-database store)
                       (%query-error "query.unsupported-store" "Geo requires Tek9."))))
    (tek9:with-read-transaction (database)
      (%geo-database store workspace)
      (let* ((revision (%geo-revision database workspace))
             (root (concatenate 'string (%geo-prefix workspace) "p/"))
             (start (or (%cursor-start request workspace revision scope root) root))
             (points nil) (bytes 0) (scanned 0) (complete nil) (reason "records"))
        (unless (or (equal start root)
                    (and (tek9:fetch* database start)
                         (some (lambda (cell) (%prefix-p (%geo-point-prefix workspace (car cell) (cdr cell)) start)) cells)))
          (%query-error "query.invalid-cursor" "Continuation is not a point in this query."))
        (block visit
          (dolist (cell cells)
            (let ((prefix (%geo-point-prefix workspace (car cell) (cdr cell))))
              (when (string< start (%prefix-end prefix))
                (loop
                  (when (>= (length points) limit) (return-from visit))
                  (when (>= scanned scan-limit) (setf reason "scan-budget") (return-from visit))
                  (when (>= (* 1000 (- (funcall *query-clock*) began)) (* deadline internal-time-units-per-second))
                    (setf reason "deadline") (return-from visit))
                  (let ((row (first (%bounded-range database prefix :start (if (%prefix-p prefix start) start nil) :limit 1))))
                    (unless row (return))
                    (incf scanned)
                    (when (%geo-contains bounds (cdr row))
                      (let ((size (%utf8-length (quasar.protocol:encode (cdr row)))))
                        (when (> (+ bytes size) (- *query-max-bytes* 32768))
                          (setf reason "bytes") (return-from visit))
                        (incf bytes size) (push (cdr row) points)))
                    (setf start (car row)))))))
          (setf complete t reason "complete"))
        (%geo-result revision (nreverse points) complete
                     (unless complete (%search-cursor workspace revision scope start)) scanned reason began)))))

(defun %geo-id (request)
  (let ((id (%query-string (json-value request "id") "id" 512)))
    (when (zerop (length id)) (%query-error "geo.invalid" "id must not be empty.")) id))

(defun %geo-live-link-p (database workspace link)
  ;; A stale/dangling link never exposes a nonexistent canonical participant.
  (every (lambda (field) (tek9:fetch* database (%document-key workspace (json-value link field))))
         '("source" "target" "via")))

(defun geo-related (store workspace request)
  (%query-keys request '("id" "limit" "cursor"))
  (let* ((id (%geo-id request)) (limit (%query-integer request "limit" 25 1 50))
         (scope (%geo-scope "related" (cons "id" id))) (began (funcall *query-clock*))
         (database (if (typep store 'tek9-store) (tek9-store-database store)
                       (%query-error "query.unsupported-store" "Geo requires Tek9."))))
    (tek9:with-read-transaction (database)
      (%geo-database store workspace)
      (let* ((revision (%geo-revision database workspace)) (prefix (%geo-link-prefix workspace "in" id))
             (start (or (%cursor-start request workspace revision scope prefix) prefix))
             (rows nil) (scanned 0) (complete nil) (reason "records"))
        (loop while (< (length rows) limit)
              do (when (>= scanned 250) (setf reason "scan-budget") (return))
                 (when (>= (* 1000 (- (funcall *query-clock*) began)) (* 50 internal-time-units-per-second))
                   (setf reason "deadline") (return))
                 (let ((row (first (%bounded-range database prefix :start start :limit 1))))
                   (unless row (setf complete t reason "complete") (return))
                   (incf scanned) (setf start (car row))
                   (when (and (equal id (json-value (cdr row) "target"))
                              (%geo-live-link-p database workspace (cdr row))) (push (cdr row) rows))))
        (%geo-result revision (nreverse rows) complete
                     (unless complete (%search-cursor workspace revision scope start)) scanned reason began "relations")))))

(defun geo-resolve (store workspace request)
  "Bounded outgoing explicit-reference traversal, at most 3 hops/64 links/8 anchors.
No derived rules. Each anchored result retains its exact canonical relation path."
  (%query-keys request '("id"))
  (let* ((id (%geo-id request)) (began (funcall *query-clock*))
         (database (if (typep store 'tek9-store) (tek9-store-database store)
                       (%query-error "query.unsupported-store" "Geo requires Tek9."))))
    (tek9:with-read-transaction (database)
      (%geo-database store workspace)
      (let ((queue (list (list id nil))) (seen (make-hash-table :test #'equal))
            (anchors nil) (scanned 0) (reason "complete") (complete t))
        (block walk
          (loop while queue
                do (when (or (>= scanned 64) (>= (length anchors) 8)
                             (>= (* 1000 (- (funcall *query-clock*) began)) (* 50 internal-time-units-per-second)))
                     (setf complete nil reason "resource-limit") (return-from walk))
                   (destructuring-bind (current path) (pop queue)
                     (unless (gethash current seen)
                       (setf (gethash current seen) t)
                       (let* ((doc (tek9:fetch* database (%document-key workspace current))) (point (%geo-point doc)))
                         (when point
                           (quasar.protocol:object-set point "anchor" current)
                           (quasar.protocol:object-set point "document" id)
                           (quasar.protocol:object-set point "participationKind" (if path "anchored" "direct"))
                           (quasar.protocol:object-set point "relationPath" (cons :array path))
                           (push point anchors))
                         (when (and doc (not point))
                           (if (>= (length path) 3)
                               (setf complete nil reason "hop-limit")
                               (let* ((prefix (%geo-link-prefix workspace "out" current))
                                      (links (%bounded-range database prefix :limit (1+ (- 64 scanned)))))
                                 (dolist (row links)
                                   (when (>= scanned 64) (setf complete nil reason "resource-limit") (return-from walk))
                                   (incf scanned)
                                   (let* ((link (cdr row)) (target (json-value link "target")))
                                     (when (and (equal current (json-value link "source"))
                                                (not (gethash target seen)) (%geo-live-link-p database workspace link))
                                       (setf queue (nconc queue (list (list target (append path (list link))))))))))))))))
        (%geo-result (%geo-revision database workspace) (nreverse anchors) complete nil scanned reason began "anchors"))))))
