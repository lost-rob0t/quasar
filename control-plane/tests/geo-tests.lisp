(in-package #:quasar.tests)

(defun geo-test-point (id lon lat)
  (quasar.protocol:json-object
   (cons "id" id) (cons "dtype" "geo-point") (cons "dataset" "synthetic-geo")
   (cons "schemaVersion" "0.10.1") (cons "geometryType" "point")
   (cons "longitude" lon) (cons "latitude" lat)))

(defun geo-test-reference (id)
  (quasar.protocol:json-object (cons "schema" "org.starintel/core@1/document") (cons "id" id)))

(defun geo-test-document (id dtype &rest fields)
  (apply #'quasar.protocol:json-object
         (append (list (cons "id" id) (cons "dtype" dtype) (cons "schemaVersion" "0.10.1")
                       (cons "dataset" "synthetic-geo")) fields)))

(defun geo-test-request (bounds &rest fields)
  (apply #'quasar.protocol:json-object (cons (cons "bbox" (cons :array bounds)) fields)))

(defun geo-test-rows (result field)
  (quasar.workspace:array-elements (quasar.protocol:json-value result field)))

(defun geo-test-error (code thunk)
  (handler-case (progn (funcall thunk) nil)
    (quasar.protocol:quasar-error (error) (equal code (quasar.protocol:quasar-error-code error)))))

(defun geo-test-seed (store workspace documents)
  (let ((state (quasar.workspace:make-workspace :id workspace)))
    (dolist (document documents)
      (quasar.protocol:require-canonical-document document)
      (setf (gethash (quasar.protocol:json-value document "id") (quasar.workspace:workspace-documents state)) document))
    (setf (quasar.workspace:workspace-revision state) 1)
    (quasar.store:save-workspace store state)))

(defun geo-test-world-count (store workspace)
  (loop for cell in (geo-test-rows (quasar.store:geo-viewport store workspace (geo-test-request '(-180 -90 180 90) (cons "zoom" 0))) "cells")
        sum (quasar.protocol:json-value cell "count")))

(defun test-geo-index-and-edges ()
  (with-temporary-tek9-store (store path "geo-edges")
    (geo-test-seed store "geo"
                   (list (geo-test-point "point" "20" "10")
                         (geo-test-point "dateline" "180" "0")
                         (geo-test-point "north" "0" "90")
                         (geo-test-point "south" "0" "-90")))
    (assert (= 4 (geo-test-world-count store "geo")))
    (assert (= 0 (geo-test-world-count store "other")))
    (let ((wrapped (quasar.store:geo-points store "geo" (geo-test-request '(179.99 -0.01 -179.99 0.01)))))
      (assert (equal '("dateline") (mapcar (lambda (row) (quasar.protocol:json-value row "id")) (geo-test-rows wrapped "points")))))
    (assert (= 1 (length (geo-test-rows (quasar.store:geo-points store "geo" (geo-test-request '(179.99d0 -0.01d0 180d0 0.01d0))) "points"))))
    (assert (quasar.store::%geo-point (geo-test-point "signed" "+20" "+10")))
    (assert (quasar.store::%geo-point (geo-test-point "precision" (concatenate 'string "20." (make-string 300 :initial-element #\0)) "10")))
    (dolist (bad '("NaN" "Infinity" "#.(error 1)" "1e2" "91"))
      (assert (null (quasar.store::%geo-point (geo-test-point "invalid" "20" bad)))))
    (let ((wrong-crs (geo-test-point "invalid" "20" "10")))
      (quasar.protocol:object-set wrong-crs "coordinateReferenceSystem" "EPSG:3857")
      (assert (null (quasar.store::%geo-point wrong-crs))))
    (dolist (request (list (geo-test-request '(0 10 5 -10)) (geo-test-request '(-181 0 0 0))
                          (geo-test-request '(0 0 0 91)) (geo-test-request '(0 0 0))))
      (assert (geo-test-error "geo.invalid" (lambda () (quasar.store:geo-viewport store "geo" request)))))
    (assert (geo-test-error "geo.zoom-in" (lambda () (quasar.store:geo-points store "geo" (geo-test-request '(-180 -90 180 90))))))
    (let ((before (geo-test-world-count store "geo")) (database (quasar.store::tek9-store-database store)))
      ;; Rollback after index changes but before commit exposes no count/point.
      (handler-case
          (tek9:with-write-transaction (database)
            (quasar.store::%geo-document-change database "geo" "point" (geo-test-point "point" "21" "11"))
            (error "injected rollback"))
        (error () nil))
      (assert (= before (geo-test-world-count store "geo")))
      (assert (= 1 (length (geo-test-rows (quasar.store:geo-points store "geo" (geo-test-request '(19.99 9.99 20.01 10.01))) "points"))))
      ;; Ordinary canonical change path updates counts and rows, not the corpus.
      (tek9:with-write-transaction (database)
        (quasar.store::%apply-change store "geo"
          (quasar.workspace:make-persistence-change :kind :document-upsert :id "point" :value (geo-test-point "point" "21" "11"))
          (quasar.store::%fresh-commit-stats)))
      (assert (= before (geo-test-world-count store "geo")))
      (assert (null (geo-test-rows (quasar.store:geo-points store "geo" (geo-test-request '(19.99 9.99 20.01 10.01))) "points")))
      (tek9:with-write-transaction (database)
        (quasar.store::%apply-change store "geo"
          (quasar.workspace:make-persistence-change :kind :document-delete :id "point")
          (quasar.store::%fresh-commit-stats)))
      (assert (= (1- before) (geo-test-world-count store "geo"))))
    (quasar.store:close-store store)
    (setf store (quasar.store:make-tek9-store :path path))
    (assert (= 3 (geo-test-world-count store "geo")))))

(defun test-geo-pagination-and-budget ()
  (with-temporary-tek9-store (store path "geo-pages")
    (geo-test-seed store "geo" (loop for i below 105 collect (geo-test-point (format nil "p~3,'0D" i) "20" "10")))
    (let ((cursor nil) (seen nil) (done nil) (bounds '(19.999 9.999 20.001 10.001)))
      (loop until done
            do (let* ((request (geo-test-request bounds (cons "limit" 17)))
                      (page (progn (when cursor (quasar.protocol:object-set request "cursor" cursor))
                                   (quasar.store:geo-points store "geo" request))))
                 (assert (<= (length (geo-test-rows page "points")) 17))
                 (assert (<= (quasar.store::%utf8-length (quasar.protocol:encode page)) (* 512 1024)))
                 (dolist (point (geo-test-rows page "points"))
                   (let ((id (quasar.protocol:json-value point "id"))) (assert (not (member id seen :test #'equal))) (push id seen)))
                 (setf cursor (quasar.protocol:json-value page "cursor") done (eq t (quasar.protocol:json-value page "complete")))))
      (assert (= 105 (length seen))))
    (let* ((bounds '(19.999 9.999 20.001 10.001))
           (page (quasar.store:geo-points store "geo" (geo-test-request bounds (cons "limit" 1))))
           (cursor (quasar.protocol:json-value page "cursor")))
      (assert (geo-test-error "query.invalid-cursor" (lambda () (quasar.store:geo-points store "other" (geo-test-request bounds (cons "cursor" cursor))))))
      (assert (geo-test-error "query.invalid-cursor" (lambda () (quasar.store:geo-points store "geo" (geo-test-request '(20 10 20.01 10.01) (cons "cursor" cursor))))))
      (let ((database (quasar.store::tek9-store-database store)))
        (tek9:with-write-transaction (database)
          (quasar.store::%put-record database (quasar.store::%workspace-meta-key "geo") (quasar.store::%default-workspace-meta "geo" 2 105))))
      (assert (geo-test-error "query.stale-cursor" (lambda () (quasar.store:geo-points store "geo" (geo-test-request bounds (cons "cursor" cursor)))))))
    (let* ((quasar.store::*query-clock* (let ((ticks 0)) (lambda () (incf ticks internal-time-units-per-second))))
           (page (quasar.store:geo-points store "geo" (geo-test-request '(19.999 9.999 20.001 10.001)))))
      (assert (equal "deadline" (quasar.protocol:json-value (quasar.protocol:json-value page "performance") "stopReason"))))
    (assert (= 105 (geo-test-world-count store "geo")))))

(defun test-geo-reference-navigation-and-rebuild ()
  (with-temporary-tek9-store (store path "geo-links")
    (let* ((point (geo-test-point "point" "20" "10"))
           (place (geo-test-document "place" "location" (cons "geometry" (geo-test-reference "point"))))
           (network (geo-test-document "network" "wireless-network" (cons "bssid" "02:00:00:00:00:01") (cons "security" "open") (cons "location" (geo-test-reference "place"))))
           (report (geo-test-document "report" "document"))
           (relation (geo-test-document "link" "relation" (cons "source" (geo-test-reference "report")) (cons "destination" (geo-test-reference "point")) (cons "predicate" "locatedAt"))))
      (geo-test-seed store "geo" (list point place network report relation))
      (assert (= 1 (geo-test-world-count store "geo")))
      (let* ((resolved (quasar.store:geo-resolve store "geo" (quasar.protocol:json-object (cons "id" "network"))))
             (anchor (first (geo-test-rows resolved "anchors"))))
        (assert (equal "anchored" (quasar.protocol:json-value anchor "participationKind")))
        (assert (equal "point" (quasar.protocol:json-value anchor "anchor")))
        (assert (= 2 (length (geo-test-rows anchor "relationPath")))))
      (let ((related (quasar.store:geo-related store "geo" (quasar.protocol:json-object (cons "id" "point")))))
        (assert (= 2 (length (geo-test-rows related "relations")))))
      (assert (= 1 (length (geo-test-rows (quasar.store:geo-resolve store "geo" (quasar.protocol:json-object (cons "id" "report"))) "anchors"))))
      (assert (null (geo-test-rows (quasar.store:geo-resolve store "other" (quasar.protocol:json-object (cons "id" "report"))) "anchors")))
      (let ((database (quasar.store::tek9-store-database store)))
        (tek9:with-write-transaction (database)
          (quasar.store::%delete-prefix-bounded database (quasar.store::%geo-prefix "geo")))
        (assert (geo-test-error "geo.index-required" (lambda () (geo-test-world-count store "geo")))))
      (assert (= 5 (quasar.store:rebuild-geo-index store "geo")))
      (assert (= 1 (geo-test-world-count store "geo")))
      (let ((before (quasar.protocol:encode (quasar.store:geo-related store "geo" (quasar.protocol:json-object (cons "id" "point"))))))
        (declare (ignore before))
        (quasar.store:rebuild-geo-index store "geo")
        (assert (= 2 (length (geo-test-rows (quasar.store:geo-related store "geo" (quasar.protocol:json-object (cons "id" "point"))) "relations"))))))))

(defun test-geo-staged-promotion-and-long-ids ()
  (with-temporary-tek9-store (store path "geo-staged")
    (let* ((point-id (make-string 300 :initial-element #\p))
           (place-id (make-string 300 :initial-element #\l))
           (point (geo-test-point point-id "20" "10"))
           (place (geo-test-document place-id "location" (cons "geometry" (geo-test-reference point-id)))))
      (quasar.store:begin-import-stage store "geo" "stage" 0 100)
      (quasar.store:accept-import-chunk store "geo" "stage" 0
        (quasar.protocol:json-array
          (quasar.protocol:json-object (cons "type" "document.create") (cons "payload" point))
          (quasar.protocol:json-object (cons "type" "document.create") (cons "payload" place))) 101)
      (assert (= 0 (geo-test-world-count store "geo")))
      (quasar.store:promote-import-stage store "geo" "stage" "op" "synthetic-test" 102)
      (assert (= 1 (geo-test-world-count store "geo")))
      (let ((resolved (quasar.store:geo-resolve store "geo" (quasar.protocol:json-object (cons "id" place-id)))))
        (assert (equal point-id (quasar.protocol:json-value (first (geo-test-rows resolved "anchors")) "anchor"))))
      (assert (= 1 (length (geo-test-rows (quasar.store:geo-related store "geo" (quasar.protocol:json-object (cons "id" point-id))) "relations")))))))

(defun test-geo-token-collision-rollback ()
  (with-temporary-tek9-store (store path "geo-collision")
    (geo-test-seed store "geo" (list (geo-test-point "existing" "20" "10")))
    (let ((original (symbol-function 'quasar.store::%fnv1a-64))
          (database (quasar.store::tek9-store-database store)))
      (unwind-protect
           (progn
             (setf (symbol-function 'quasar.store::%fnv1a-64)
                   (lambda (value) (if (search "collision-" value) "0000000000000000" (funcall original value))))
             (assert (geo-test-error "geo.index-collision"
                      (lambda ()
                        (tek9:with-write-transaction (database)
                          (dolist (id '("collision-a" "collision-b"))
                            (quasar.store::%apply-change store "geo"
                              (quasar.workspace:make-persistence-change :kind :document-upsert :id id :value (geo-test-point id "20" "10"))
                              (quasar.store::%fresh-commit-stats))))))))
        (setf (symbol-function 'quasar.store::%fnv1a-64) original))
      (assert (= 1 (geo-test-world-count store "geo")))
      (assert (null (quasar.store:direct-document store "geo" "collision-a")))
      (assert (null (quasar.store:direct-document store "geo" "collision-b"))))))

(defun run-geo-tests ()
  (test-geo-index-and-edges)
  (test-geo-pagination-and-budget)
  (test-geo-reference-navigation-and-rebuild)
  (test-geo-staged-promotion-and-long-ids)
  (test-geo-token-collision-rollback)
  (format t "Geo: index/rollback/restart, viewport/budgets/cursors, canonical relation paths and rebuild passed.~%"))

(defun run-geo-authority-tests ()
  ;; Runs in the full Quasar suite, not the supplemental store-only harness.
  (with-temporary-tek9-store (store path "geo-authority")
    (geo-test-seed store "geo" (list (geo-test-point "point" "20" "10")))
    (let* ((plane (quasar.control-plane:start-control-plane (quasar.control-plane:make-control-plane :store store)))
           (server (quasar.ws:make-websocket-server plane :insecure-development-p t))
           (original (symbol-function 'quasar.ws::send-connection-text)) (response nil))
      (unwind-protect
           (progn
             (setf (symbol-function 'quasar.ws::send-connection-text)
                   (lambda (connection encoded) (declare (ignore connection)) (setf response encoded)))
             (dolist (command '("geo.viewport" "geo.points" "geo.related" "geo.resolve"))
               (let ((payload (if (member command '("geo.viewport" "geo.points") :test #'equal)
                                  (geo-test-request '(19.99d0 9.99d0 20.01d0 10.01d0))
                                  (quasar.protocol:json-object (cons "id" "point")))))
                 (assert (equal "ok" (status (call-command plane (make-envelope command payload :workspace "geo")))))
                 (dolist (case '("missing-capability" "wrong-workspace"))
                   (let ((connection (make-instance 'quasar.ws::ws-connection
                                       :id "geo-authority" :ws nil :session-id "geo-authority" :session-token "geo-authority"
                                       :principal "reader" :authorized-workspaces '("geo")
                                       :capabilities (if (equal case "missing-capability") nil (list command)))))
                     (setf response nil)
                     (quasar.ws::handle-text-message server connection
                        (make-envelope command payload :workspace (if (equal case "wrong-workspace") "other" "geo")))
                     (assert (equal "security.forbidden" (error-code response)))))))
             (assert (zerop (hash-table-count (quasar.control-plane:control-plane-workspaces plane)))))
        (setf (symbol-function 'quasar.ws::send-connection-text) original)
        (quasar.control-plane:stop-control-plane plane)))))
