(in-package #:quasar.tests)

(defun statistics-document (id dtype &key (dataset "alpha") (reviewed t) related (name id) source target)
  (let ((doc (dataset-test-document id dataset dtype 1)))
    (quasar.protocol:object-set doc "name" name)
    (quasar.protocol:object-set doc "extensions"
                               (quasar.protocol:json-object
                                (cons "quasarLegacy090"
                                      (quasar.protocol:json-object
                                       (cons "verification" (quasar.protocol:json-object (cons "verified" (if reviewed t :false))))
                                       (cons "related_ids" (cons :array related))))))
    (when source (quasar.protocol:object-set doc "source" (quasar.protocol:json-object (cons "id" source))))
    (when target (quasar.protocol:object-set doc "destination" (quasar.protocol:json-object (cons "id" target))))
    doc))
(defun statistics-query (store section &rest fields)
  (quasar.store:workspace-statistics store "datasets"
                                    (apply #'quasar.protocol:json-object (cons "section" section) fields)))
(defun statistics-summary (store)
  (quasar.protocol:json-value (statistics-query store "summary") "statistics"))
(defun statistics-top (store)
  (quasar.workspace:array-elements (quasar.protocol:json-value (statistics-summary store) "topConnected")))
(defun statistics-datasets (store)
  (quasar.workspace:array-elements (quasar.protocol:json-value (statistics-query store "datasets") "datasets")))

(defun test-statistics-review-semantics ()
  (let ((doc (statistics-document "a" "person")))
    (check (quasar.store::%statistics-reviewed-p doc))
    (let ((v (quasar.protocol:json-value (quasar.store::%statistics-legacy doc) "verification")))
      (quasar.protocol:object-set v "verified" :false)
      (quasar.protocol:object-set v "status" "verified")
      (quasar.protocol:object-set v "last_reviewed_at" "yesterday")
      (check (not (quasar.store::%statistics-reviewed-p doc)))
      (quasar.protocol:object-set v "verified" :null)
      (quasar.protocol:object-set v "status" "  APPROVED  ")
      (check (quasar.store::%statistics-reviewed-p doc))
      (quasar.protocol:object-set v "status" "not reviewed")
      (quasar.protocol:object-set v "last_reviewed_at" 0)
      (check (not (quasar.store::%statistics-reviewed-p doc)))
      (quasar.protocol:object-set v "last_reviewed_at" "today")
      (check (quasar.store::%statistics-reviewed-p doc)))
    (quasar.protocol:object-set doc "extensions" (quasar.protocol:empty-object))
    (quasar.protocol:object-set doc "verificationStatus" "verified")
    (quasar.protocol:object-set doc "verifiedAt" 1)
    (check (not (quasar.store::%statistics-reviewed-p doc))))
  (check (equal "canonical" (quasar.store::%statistics-label
                             (let ((doc (statistics-document "e" "entity" :name "secondary")))
                               (quasar.protocol:object-set doc "canonicalName" "canonical") doc)))))

(defun test-statistics-deltas ()
  (with-temporary-tek9-store (store path "statistics-deltas")
    (check (= 0 (quasar.protocol:json-value (statistics-summary store) "documents")))
    (check (null (statistics-top store)))
    (dataset-test-change store :document-upsert "a" (statistics-document "a" "person" :name "Alice" :related '("a" "ghost" "ghost")))
    (dataset-test-change store :document-upsert "b" (statistics-document "b" "organization" :dataset "beta" :reviewed nil))
    (dataset-test-change store :document-upsert "r" (statistics-document "r" "relation" :source "b" :target "a"))
    (dataset-test-change store :document-upsert "z" (statistics-document "z" "event" :name "Zero"))
    (let ((summary (statistics-summary store)) (top (statistics-top store)))
      (check (= 4 (quasar.protocol:json-value summary "documents")))
      (check (= 3 (quasar.protocol:json-value summary "reviewedDocuments")))
      (check (= 1 (quasar.protocol:json-value summary "reviewedEntities")))
      (check (= 1 (quasar.protocol:json-value summary "reviewedRelations")))
      (check (= 1 (quasar.protocol:json-value summary "reviewedEvents")))
      (check (= 75 (quasar.protocol:json-value summary "reviewPercent")))
      (check (equal '("a" "ghost" "b" "z") (mapcar (lambda (row) (quasar.protocol:json-value row "id")) top)))
      (check (equal '(5 2 1 0) (mapcar (lambda (row) (quasar.protocol:json-value row "count")) top)))
      (check (equal "Alice" (quasar.protocol:json-value (first top) "label")))
      (check (equal "b" (quasar.protocol:json-value (third top) "label"))))
    ;; A referenced unreviewed node becomes reviewed; label changes but degree is retained.
    (dataset-test-change store :document-upsert "b" (statistics-document "b" "organization" :dataset "beta" :name "Business"))
    (check (= 1 (quasar.protocol:json-value (statistics-summary store) "reviewedEntities")))
    (check (equal "Business" (quasar.protocol:json-value (third (statistics-top store)) "label")))
    (check (= 2 (length (statistics-datasets store))))
    ;; Demotion/removal preserves unresolved references and tied insertion phases.
    (dataset-test-change store :document-delete "a")
    (check (equal '("b" "a" "z") (mapcar (lambda (row) (quasar.protocol:json-value row "id")) (statistics-top store))))
    (check (equal '(1 1 0) (mapcar (lambda (row) (quasar.protocol:json-value row "count")) (statistics-top store))))
    (dataset-test-change store :document-delete "r")
    (check (equal '("b" "z") (mapcar (lambda (row) (quasar.protocol:json-value row "id")) (statistics-top store))))
    (check (handler-case (progn (dataset-test-change store :document-delete "b" nil t) nil) (error () t)))
    (check (= 2 (quasar.protocol:json-value (statistics-summary store) "documents")))
    (quasar.store:close-store store)
    (setf store (quasar.store:make-tek9-store :path path))
    (check (= 2 (quasar.protocol:json-value (statistics-summary store) "documents")))
    (dataset-test-change store :document-delete "b")
    (dataset-test-change store :document-delete "b")
    (check (= 1 (quasar.protocol:json-value (statistics-summary store) "documents")))))

(defun test-statistics-order-and-bounds ()
  (with-temporary-tek9-store (store path "statistics-order")
    ;; Insert in reverse order: ranking uses primary-key order, not mutation order.
    (dolist (id '("b" "a"))
      (dataset-test-change store :document-upsert id (statistics-document id "relation" :source (concatenate 'string id "-src") :target (concatenate 'string id "-dst"))))
    (check (equal '("a-src" "a-dst" "b-src" "b-dst") (mapcar (lambda (row) (quasar.protocol:json-value row "id")) (statistics-top store))))
    (dataset-test-change store :document-delete "a")
    (check (equal '("b-src" "b-dst") (mapcar (lambda (row) (quasar.protocol:json-value row "id")) (statistics-top store))))
    (dotimes (n 51)
      (let ((id (format nil "d~2,'0D" n)))
        (dataset-test-change store :document-upsert id (statistics-document id "person" :dataset id))))
    (check (= 12 (length (statistics-top store))))
    (let* ((page (statistics-query store "datasets" (cons "limit" 50)))
           (cursor (quasar.protocol:json-value page "cursor")))
      (check (= 50 (length (quasar.workspace:array-elements (quasar.protocol:json-value page "datasets")))))
      (check (equal "alpha" (quasar.protocol:json-value (first (statistics-datasets store)) "name")))
      (check (= 2 (length (quasar.workspace:array-elements (quasar.protocol:json-value
                          (statistics-query store "datasets" (cons "cursor" cursor)) "datasets")))))
      (check (bounded-error-p "query.invalid-cursor" (lambda () (quasar.store:workspace-statistics store "other"
                (quasar.protocol:json-object (cons "section" "datasets") (cons "cursor" cursor))))))
      (dataset-test-change store :document-delete "b")
      (check (bounded-error-p "query.stale-cursor" (lambda () (statistics-query store "datasets" (cons "cursor" cursor))))))
    (let ((fetch (symbol-function 'tek9:fetch*)) (range (symbol-function 'tek9:select-primary-range)))
      (unwind-protect
           (progn
             (setf (symbol-function 'tek9:fetch*)
                   (lambda (db key &rest args)
                     (assert (not (quasar.store::%prefix-p (quasar.store::%document-prefix "datasets") key)))
                     (apply fetch db key args))
                   (symbol-function 'tek9:select-primary-range)
                   (lambda (db start &rest args)
                     (assert (or (quasar.store::%prefix-p (quasar.store::%statistics-key "datasets" "datasets/") start)
                                 (quasar.store::%prefix-p (quasar.store::%statistics-rank-prefix "datasets") start)))
                     (apply range db start args)))
             (check (<= (quasar.store::%utf8-length (quasar.protocol:encode-result "stats" (statistics-query store "summary" (cons "byteLimit" 32768)))) 32768))
             (statistics-query store "datasets" (cons "limit" 1)))
        (setf (symbol-function 'tek9:fetch*) fetch (symbol-function 'tek9:select-primary-range) range)))
    (check (bounded-error-p "query.stale-cursor" (lambda () (statistics-query store "summary" (cons "expectedRevision" 0)))))
    (check (bounded-error-p "query.invalid" (lambda () (statistics-query store "summary" (cons "byteLimit" 1)))))))

(defun test-statistics-migration-import ()
  (with-temporary-tek9-store (store path "statistics-migration")
    (let ((db (quasar.store::tek9-store-database store)))
      (tek9:with-write-transaction (db)
        (quasar.store::%put-record db (quasar.store::%workspace-meta-key "datasets") (quasar.store::%default-workspace-meta "datasets" 4 1))
        (quasar.store::%put-record db (quasar.store::%document-key "datasets" "a") (statistics-document "a" "person")))
      (check (bounded-error-p "workspace.statistics-migration-required" (lambda () (statistics-summary store))))
      (check (bounded-error-p "query.stale-cursor" (lambda () (quasar.store:migrate-workspace-statistics store "datasets" :expected-revision 0))))
      (setf (quasar.store:tek9-store-failure-hook store) (lambda (point) (when (eq point :before-statistics-ready) (error "migration rollback"))))
      (check (handler-case (progn (quasar.store:migrate-workspace-statistics store "datasets") nil) (error () t)))
      (check (not (quasar.store::%statistics-ready-p db "datasets")))
      (check (null (tek9:fetch* db (quasar.store::%statistics-key "datasets" "summary"))))
      (setf (quasar.store:tek9-store-failure-hook store) nil)
      (quasar.store:migrate-workspace-statistics store "datasets" :expected-revision 4)
      (quasar.store:migrate-workspace-statistics store "datasets" :expected-revision 4)
      (check (= 1 (quasar.protocol:json-value (statistics-summary store) "reviewedDocuments")))
      (tek9:with-write-transaction (db)
        (quasar.store::%put-record db (quasar.store::%stage-document-key "datasets" "stage" "a") (statistics-document "a" "person" :reviewed nil)))
      (check (handler-case (tek9:with-write-transaction (db) (quasar.store::%promote-stage-documents db "datasets" "stage") (error "import rollback")) (error () t)))
      (check (= 1 (quasar.protocol:json-value (statistics-summary store) "reviewedDocuments")))
      (tek9:with-write-transaction (db) (quasar.store::%promote-stage-documents db "datasets" "stage"))
      (check (= 0 (quasar.protocol:json-value (statistics-summary store) "reviewedDocuments")))
      (check (null (statistics-top store)))
      (check (null (statistics-datasets store)))
      (quasar.store:close-store store)
      (setf store (quasar.store:make-tek9-store :path path))
      (check (= 1 (quasar.protocol:json-value (statistics-summary store) "unreviewedDocuments"))))))

(defun run-workspace-statistics-tests ()
  (let ((*failures* 0))
    (test-statistics-review-semantics)
    (test-statistics-deltas)
    (test-statistics-order-and-bounds)
    (test-statistics-migration-import)
    (when (plusp *failures*) (error "~D workspace statistics checks failed." *failures*))
    t))
