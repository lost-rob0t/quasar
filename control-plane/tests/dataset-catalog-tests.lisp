(in-package #:quasar.tests)

(defun dataset-test-document (id dataset dtype time)
  (quasar.protocol:json-object (cons "id" id) (cons "dataset" dataset)
                               (cons "dtype" dtype) (cons "schemaVersion" "0.10.1")
                               (cons "updatedAt" time)))
(defun dataset-test-page (store &rest fields)
  (quasar.store:dataset-catalog-page store "datasets" (apply #'quasar.protocol:json-object fields)))
(defun dataset-test-rows (store)
  (quasar.workspace:array-elements (quasar.protocol:json-value (dataset-test-page store) "datasets")))
(defun dataset-test-change (store kind id &optional document fail)
  (let* ((workspace (make-instance 'quasar.workspace:persistent-workspace :id "datasets"))
         (base (quasar.store:direct-workspace-revision store "datasets"))
         (operation (quasar.protocol:json-object (cons "baseRevision" base) (cons "committedRevision" (1+ base))
                                                 (cons "operationId" (format nil "dataset-~D" base)))))
    ;; Normal candidate application owns documentCount; this focused persistence
    ;; fixture only checks the independent authoritative dataset summaries.
    (setf (quasar.workspace:workspace-revision workspace) (1+ base))
    (vector-push-extend (quasar.workspace:make-persistence-change :kind kind :id id :value document)
                        (quasar.workspace:workspace-persistence-changes workspace))
    (setf (quasar.store:tek9-store-failure-hook store)
          (when fail (lambda (point) (when (eq point :before-commit) (error "dataset rollback")))))
    (unwind-protect (quasar.store:commit-workspace store workspace operation)
      (setf (quasar.store:tek9-store-failure-hook store) nil))))

(defun test-dataset-catalog-deltas ()
  (with-temporary-tek9-store (store path "dataset-deltas")
    (check (null (dataset-test-rows store)))
    (dataset-test-change store :document-upsert "a" (dataset-test-document "a" "alpha" "person" 10))
    (dataset-test-change store :document-upsert "b" (dataset-test-document "b" "alpha" "organization" 20))
    (dataset-test-change store :document-upsert "c" (dataset-test-document "c" "alpha" "person" 20))
    (let ((row (first (dataset-test-rows store))))
      (check (= 3 (quasar.protocol:json-value row "documentCount")))
      (check (= 20 (quasar.protocol:json-value row "updatedAt")))
      (check (equal '("organization" "person") (quasar.workspace:array-elements (quasar.protocol:json-value row "types")))))
    (dataset-test-change store :document-delete "b")
    (check (= 20 (quasar.protocol:json-value (first (dataset-test-rows store)) "updatedAt")))
    (dataset-test-change store :document-delete "c")
    (check (= 10 (quasar.protocol:json-value (first (dataset-test-rows store)) "updatedAt")))
    (dataset-test-change store :document-upsert "a" (dataset-test-document "a" "beta" "person" 5))
    (let ((row (first (dataset-test-rows store))))
      (check (= 1 (length (dataset-test-rows store))))
      (check (equal "beta" (quasar.protocol:json-value row "name")))
      (check (= 1 (quasar.protocol:json-value row "documentCount"))))
    (check (handler-case
               (progn (dataset-test-change store :document-upsert "a" (dataset-test-document "a" "gamma" "person" 99) t) nil)
             (error () t)))
    (check (equal "beta" (quasar.protocol:json-value (first (dataset-test-rows store)) "name")))
    (quasar.store:close-store store)
    (setf store (quasar.store:make-tek9-store :path path))
    (check (= 5 (quasar.protocol:json-value (first (dataset-test-rows store)) "updatedAt")))
    (dataset-test-change store :document-delete "a")
    (dataset-test-change store :document-delete "a")
    (check (null (dataset-test-rows store)))))

(defun test-dataset-catalog-migration-and-import ()
  (with-temporary-tek9-store (store path "dataset-migration")
    (let ((db (quasar.store::tek9-store-database store)))
      (tek9:with-write-transaction (db)
        (quasar.store::%put-record db (quasar.store::%workspace-meta-key "datasets")
                                  (quasar.store::%default-workspace-meta "datasets" 4 1))
        (quasar.store::%put-record db (quasar.store::%document-key "datasets" "a")
                                  (dataset-test-document "a" "old" "person" 10)))
      (check (bounded-error-p "dataset.catalog-migration-required" (lambda () (dataset-test-page store))))
      (check (bounded-error-p "query.stale-cursor"
                              (lambda () (quasar.store:migrate-dataset-catalog store "datasets" :expected-revision 3))))
      (setf (quasar.store:tek9-store-failure-hook store)
            (lambda (point) (when (eq point :before-dataset-catalog-ready) (error "dataset migration failure"))))
      (check (handler-case (progn (quasar.store:migrate-dataset-catalog store "datasets") nil) (error () t)))
      (check (null (tek9:fetch* db (quasar.store::%dataset-key "datasets" "old"))))
      (quasar.store:close-store store)
      (setf store (quasar.store:make-tek9-store :path path)
            db (quasar.store::tek9-store-database store))
      (check (bounded-error-p "dataset.catalog-migration-required" (lambda () (dataset-test-page store))))
      (quasar.store:migrate-dataset-catalog store "datasets" :expected-revision 4)
      (check (= 1 (quasar.protocol:json-value (first (dataset-test-rows store)) "documentCount")))
      ;; A staged overwrite moves the existing document between datasets.
      (tek9:with-write-transaction (db)
        (quasar.store::%put-record db (quasar.store::%stage-document-key "datasets" "stage" "a")
                                  (dataset-test-document "a" "imported" "organization" 30)))
      (check (handler-case
                 (tek9:with-write-transaction (db)
                   (quasar.store::%promote-stage-documents db "datasets" "stage")
                   (error "failure after dataset import changes"))
               (error () t)))
      (check (equal "old" (quasar.protocol:json-value (first (dataset-test-rows store)) "name")))
      (check (equal "old" (quasar.protocol:json-value
                           (tek9:fetch* db (quasar.store::%document-key "datasets" "a")) "dataset")))
      (tek9:with-write-transaction (db)
        (check (= 0 (quasar.store::%promote-stage-documents db "datasets" "stage"))))
      (let ((row (first (dataset-test-rows store))))
        (check (= 1 (length (dataset-test-rows store))))
        (check (equal "imported" (quasar.protocol:json-value row "name")))
        (check (= 30 (quasar.protocol:json-value row "updatedAt"))))
      (quasar.store:close-store store)
      (setf store (quasar.store:make-tek9-store :path path))
      (check (equal "imported" (quasar.protocol:json-value (first (dataset-test-rows store)) "name"))))))

(defun test-dataset-catalog-pages ()
  (with-temporary-tek9-store (store path "dataset-pages")
    (dotimes (n 5)
      (let ((id (format nil "d~D" n)))
        (dataset-test-change store :document-upsert id (dataset-test-document id id "person" n))))
    (with-bounded-read-instrumentation
     (lambda ()
       (let ((cursor nil) (seen 0) (complete nil))
         (loop until complete
               do (let ((page (apply #'dataset-test-page store (cons "limit" 2)
                                     (when cursor (list (cons "cursor" cursor))))))
                    (incf seen (length (quasar.workspace:array-elements (quasar.protocol:json-value page "datasets"))))
                    (check (<= (quasar.store::%utf8-length (quasar.protocol:encode-result "test" page)) 524288))
                    (setf complete (eq t (quasar.protocol:json-value page "complete"))
                          cursor (quasar.protocol:json-value page "cursor"))))
         (check (= 5 seen)))))
    (let* ((page (dataset-test-page store (cons "limit" 1)))
           (cursor (quasar.protocol:json-value page "cursor")))
      (check (bounded-error-p "query.invalid-cursor"
                              (lambda () (quasar.store:dataset-catalog-page store "other"
                                           (quasar.protocol:json-object (cons "cursor" cursor))))))
      (dataset-test-change store :document-delete "d0")
      (check (bounded-error-p "query.stale-cursor" (lambda () (dataset-test-page store (cons "cursor" cursor)))))
      (check (bounded-error-p "query.stale-cursor" (lambda () (dataset-test-page store (cons "expectedRevision" 0))))))
    (let* ((ticks 0) (quasar.store::*query-clock* (lambda () (incf ticks internal-time-units-per-second)))
           (page (dataset-test-page store)))
      (check (eq :false (quasar.protocol:json-value page "complete")))
      (check (stringp (quasar.protocol:json-value page "cursor")))
      (check (null (quasar.workspace:array-elements (quasar.protocol:json-value page "datasets")))))))

(defun test-dataset-catalog-limits-and-null-time ()
  (with-temporary-tek9-store (store path "dataset-limits")
    (let ((document (dataset-test-document "a" "alpha" "person" 0)))
      (setf (cdr document) (remove "updatedAt" (cdr document) :key #'car :test #'equal))
      (dataset-test-change store :document-upsert "a" document))
    (check (eq :null (quasar.protocol:json-value (first (dataset-test-rows store)) "updatedAt")))
    (dataset-test-change store :document-upsert "b" (dataset-test-document "b" "alpha" "person" 0))
    (check (eql 0 (quasar.protocol:json-value (first (dataset-test-rows store)) "updatedAt")))
    (dataset-test-change store :document-delete "b")
    (check (eq :null (quasar.protocol:json-value (first (dataset-test-rows store)) "updatedAt")))
    (check (bounded-error-p "dataset.catalog-invalid"
                            (lambda () (dataset-test-change store :document-upsert "a"
                                         (dataset-test-document "a" "alpha" "person" (ash 1 257))))))
    (check (= 1 (quasar.protocol:json-value (first (dataset-test-rows store)) "documentCount")))
    (let ((fetch (symbol-function 'tek9:fetch*))
          (range (symbol-function 'tek9:select-primary-range)))
      (unwind-protect
           (progn
             (setf (symbol-function 'tek9:fetch*)
                   (lambda (db key &rest arguments)
                     (assert (not (quasar.store::%prefix-p (quasar.store::%document-prefix "datasets") key)))
                     (apply fetch db key arguments)))
             (setf (symbol-function 'tek9:select-primary-range)
                   (lambda (db start &rest arguments)
                     (assert (quasar.store::%prefix-p (quasar.store::%dataset-prefix "datasets") start))
                     (apply range db start arguments)))
             (let ((page (dataset-test-page store (cons "byteLimit" 32768))))
               (check (<= (quasar.store::%utf8-length (quasar.protocol:encode-result "datasets" page)) 32768))))
        (setf (symbol-function 'tek9:fetch*) fetch
              (symbol-function 'tek9:select-primary-range) range)))))

(defun run-dataset-catalog-tests ()
  (let ((*failures* 0))
    (test-dataset-catalog-limits-and-null-time)
    (test-dataset-catalog-deltas)
    (test-dataset-catalog-migration-and-import)
    (test-dataset-catalog-pages)
    (when (plusp *failures*) (error "~D dataset catalog checks failed." *failures*))
    t))
