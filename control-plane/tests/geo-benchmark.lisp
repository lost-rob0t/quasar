(in-package #:quasar.tests)

(defun geo-benchmark-clock ()
  (multiple-value-bind (seconds micros) (sb-ext:get-time-of-day)
    (+ (* seconds 1000000) micros)))

(defun geo-benchmark-seed (store count)
  "Synthetic radio-network shapes only. COUNT points plus COUNT network records."
  (let ((database (quasar.store::tek9-store-database store)))
    (tek9:with-write-transaction (database)
      (dotimes (i count)
        (let* ((id (format nil "synthetic-point:~8,'0D" i))
               (dense (not (zerop (mod i 4))))
               (lon (if dense (+ 20d0 (/ (mod i 100) 1000000d0)) (- (/ (mod (* i 137) 358000) 1000d0) 179d0)))
               (lat (if dense (+ 10d0 (/ (mod i 100) 1000000d0)) (- (/ (mod (* i 73) 160000) 1000d0) 80d0)))
               (point (geo-test-point id (format nil "~,6F" lon) (format nil "~,6F" lat)))
               (network (geo-test-document (format nil "synthetic-network:~8,'0D" i) "wireless-network"
                                          (cons "bssid" (format nil "02:00:~2,'0X:~2,'0X:~2,'0X:~2,'0X" (ldb (byte 8 24) i) (ldb (byte 8 16) i) (ldb (byte 8 8) i) (ldb (byte 8 0) i)))
                                          (cons "security" "open") (cons "location" (geo-test-reference id)))))
          (when (zerop i)
            (quasar.protocol:require-canonical-document point)
            (quasar.protocol:require-canonical-document network))
          (dolist (document (list point network))
            (let ((document-id (quasar.protocol:json-value document "id")))
              (quasar.store::%geo-document-change database "geo-bench" document-id document)
              (quasar.store::%put-record database (quasar.store::%document-key "geo-bench" document-id) document)))))
      (quasar.store::%put-record database (quasar.store::%workspace-meta-key "geo-bench")
                                 (quasar.store::%default-workspace-meta "geo-bench" 1 (* 2 count))))))

(defun geo-benchmark-query (name thunk)
  (let ((times nil) (bytes 0) (sample nil) (range-calls 0) (decoded-rows 0)
        (original-range (symbol-function 'tek9:select-primary-range))
        (original-load (symbol-function 'quasar.store:load-workspace)))
    (unwind-protect
         (progn
           (setf (symbol-function 'quasar.store:load-workspace)
                 (lambda (&rest args) (declare (ignore args)) (error "Geo must not hydrate the corpus.")))
           (setf (symbol-function 'tek9:select-primary-range)
                 (lambda (database start &rest options &key limit &allow-other-keys)
                   (assert (and limit (<= limit 65)))
                   (assert (not (search "/doc/" start)))
                   (incf range-calls)
                   (let ((rows (apply original-range database start options))) (incf decoded-rows (length rows)) rows)))
           ;; Warm one query, then measure 30 sequential requests.
           (funcall thunk)
           (setf range-calls 0 decoded-rows 0)
           (dotimes (i 30)
             (let ((start (geo-benchmark-clock)) (allocated (sb-ext:get-bytes-consed)))
               (setf sample (funcall thunk))
               (incf bytes (- (sb-ext:get-bytes-consed) allocated))
               (push (* 1000d0 (/ (- (geo-benchmark-clock) start) 1000000)) times)))
           (setf times (sort times #'<))
           (sb-ext:gc :full t)
           (quasar.protocol:json-object
            (cons "scenario" name) (cons "iterations" 30)
            (cons "p50Ms" (nth 14 times)) (cons "p95Ms" (nth 28 times))
            (cons "meanAllocatedBytes" (ceiling bytes 30))
            (cons "processLiveDynamicHeapBytes" (sb-kernel:dynamic-usage))
            (cons "responseBytes" (quasar.store::%utf8-length (quasar.protocol:encode sample)))
            (cons "rangeCallsPerQuery" (/ range-calls 30))
            (cons "decodedRangeRowsPerQuery" (/ decoded-rows 30))
            (cons "scanned" (quasar.protocol:json-value (quasar.protocol:json-value sample "performance") "scanned"))
            (cons "returned" (length (or (geo-test-rows sample "cells") (geo-test-rows sample "points") (geo-test-rows sample "relations"))))))
      (setf (symbol-function 'tek9:select-primary-range) original-range
            (symbol-function 'quasar.store:load-workspace) original-load))))

(defun run-geo-benchmark (&optional (counts '(1000 10000 100000)))
  (let ((results nil))
    (dolist (count counts)
      (with-temporary-tek9-store (store path "geo-benchmark")
        (let ((start (geo-benchmark-clock)))
          (geo-benchmark-seed store count)
          (let* ((seed-ms (* 1000d0 (/ (- (geo-benchmark-clock) start) 1000000)))
                 (queries (list
                           (geo-benchmark-query "world-clusters" (lambda () (quasar.store:geo-viewport store "geo-bench" (geo-test-request '(-180 -90 180 90) (cons "zoom" 0)))))
                           (geo-benchmark-query "dense-point-page" (lambda () (quasar.store:geo-points store "geo-bench" (geo-test-request '(19.999d0 9.999d0 20.001d0 10.001d0) (cons "limit" 100)))))
                           (geo-benchmark-query "sparse-point-page" (lambda () (quasar.store:geo-points store "geo-bench" (geo-test-request '(-179.001d0 -80.001d0 -178.999d0 -79.999d0)))))
                           (geo-benchmark-query "related-network" (lambda () (quasar.store:geo-related store "geo-bench" (quasar.protocol:json-object (cons "id" "synthetic-point:00000001")))))))
                 (result (quasar.protocol:json-object (cons "pointAnchors" count) (cons "canonicalDocuments" (* 2 count))
                                                     (cons "seedMs" seed-ms)
                                                     (cons "dataFileBytes" (with-open-file (stream (merge-pathnames "data.mdb" path) :element-type '(unsigned-byte 8)) (file-length stream)))
                                                     (cons "queries" (cons :array queries)))))
            (format t "GEO-BENCH ~A~%" (quasar.protocol:encode result))
            (finish-output)
            (push result results)))))
    (nreverse results)))
