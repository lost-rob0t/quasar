{
  "name": "quasar",
  "version": "0.2.0",
  "private": true,
  "description": "Quasar monorepo: React/Vite UI + Common Lisp control plane + CLOG host + WebSocket bridge.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "smoke": "node scripts/smoke-startup.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "npm run test:lisp && npm --prefix frontend run test:unit && npm --prefix frontend run test:integration",
    "test:lisp": "bash scripts/test-lisp",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:integration:stack": "node scripts/smoke-startup.mjs",
    "check:control-plane-deps": "node scripts/check-control-plane-deps.mjs",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "check": "npm --prefix frontend run check && node scripts/check-control-plane-deps.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "ws": "^8.21.1"
  }
}
