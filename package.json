{
  "name": "quasar",
  "version": "0.2.0",
  "private": true,
  "description": "Quasar monorepo: React/Vite UI + Common Lisp control plane + CLOG host + WebSocket bridge.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "test": "npm run test:lisp && npm run test --workspace frontend",
    "test:lisp": "bash scripts/test-lisp",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "format": "npm run format --workspace frontend",
    "check": "npm run check --workspace frontend"
  },
  "workspaces": [
    "frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
