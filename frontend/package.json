{
  "name": "quasar-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run src tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check:static": "node --check public/sw.js && node --check public/sw-runtime.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run check:static",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "cytoscape": "^3.34.0",
    "cytoscape-edgehandles": "^4.0.1",
    "events": "^3.3.0",
    "lucide-react": "^1.25.0",
    "pouchdb-browser": "^9.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "starintel_doc": "github:lost-rob0t/starintel_doc.js#ef9ea6b84fa6060013babdfd361f64660b2a5ebf"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.1",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
