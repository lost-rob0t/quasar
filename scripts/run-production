#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tek9_path="${QUASAR_TEK9_PATH:-$HOME/starintel/tek9}"
build_only=0
if [[ "${1:-}" == "--build-only" ]]; then
  build_only=1
  shift
fi

if [[ "$(uname -s)" == "Linux" \
  && -z "${QUASAR_PRODUCTION_NIX_READY:-}" \
  && -d /nix/store \
  && -f "$repo_root/flake.nix" \
  && -x "$(command -v nix 2>/dev/null || true)" ]]; then
  echo "[production] Entering the repository Nix shell for native runtime libraries..."
  if [[ "$build_only" -eq 1 ]]; then
    exec nix develop -c env QUASAR_PRODUCTION_NIX_READY=1 bash scripts/run-production --build-only "$@"
  fi
  exec nix develop -c env QUASAR_PRODUCTION_NIX_READY=1 bash scripts/run-production "$@"
fi

export CL_SOURCE_REGISTRY="(:source-registry (:tree \"$tek9_path/\") (:tree \"$HOME/quicklisp/local-projects/\") (:tree \"$HOME/quicklisp/dists/quicklisp/software/\") (:tree \"$repo_root/systems/\") :ignore-inherited-configuration)"

# A single root install is the supported monorepo dependency path.
cd "$repo_root"
node scripts/check-native-runtime.mjs
npm ci
npm run build

# Build the Lisp systems and save an executable. Keep this dependency list
# identical to scripts/run-control-plane; CI statically guards the contract.
sbcl --non-interactive \
  --eval '(setf asdf:*central-registry* nil)' \
  --eval '(asdf:clear-configuration)' \
  --eval '(ql:quickload (list :babel :bordeaux-threads :clack :clog :dexador :jsown :quri :sento :tek9 :websocket-driver) :silent t)' \
  --eval '(asdf:load-asd (truename "systems/quasar-control.asd"))' \
  --eval '(asdf:load-asd (truename "systems/quasar-starlang.asd"))' \
  --eval '(asdf:load-asd (truename "systems/quasar-web.asd"))' \
  --eval '(asdf:load-system :quasar-web)' \
  --eval "(sb-ext:save-lisp-and-die \"quasar-server\" :executable t :toplevel 'quasar.app:main)"

echo "Built quasar-server executable"

if [[ "$build_only" -eq 0 ]]; then
  exec "$repo_root/quasar-server" "$@"
fi
