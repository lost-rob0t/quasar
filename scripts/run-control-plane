#!/usr/bin/env bash
# Canonical Quasar control-plane launcher.
#
# This script is the single source of truth for the SBCL invocation that
# boots the CLOG host + WebSocket control plane. scripts/dev.mjs and CI
# reuse this launcher rather than maintaining their own inline SBCL
# commands, so the Quicklisp dependency set cannot drift between them.
# scripts/check-control-plane-deps.mjs statically verifies that the
# dependency list below matches the union of :depends-on entries declared
# in the ASDF system definitions under systems/.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"

# Isolate ASDF source registry from user-local CL projects
export CL_SOURCE_REGISTRY="(:source-registry (:tree \"$HOME/quicklisp/local-projects/\") (:tree \"$HOME/quicklisp/dists/quicklisp/software/\") (:tree \"$repo_root/systems/\") :ignore-inherited-configuration)"

# Best-effort support for direct invocation on Nix hosts outside nix develop.
# npm run dev normally enters the flake shell first; this fallback must cover
# every native runtime library Quasar declares, not an arbitrary subset.
for native_name in openssl rabbitmq-c libffi sqlite lmdb; do
  native_lib="$(nix-store -q --requisites /nix/var/nix/profiles/default 2>/dev/null | grep -m1 "$native_name" || true)"
  if [[ -n "${native_lib}" && -d "${native_lib}/lib" ]]; then
    export LD_LIBRARY_PATH="${native_lib}/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  fi
done

cd "$repo_root"

# When LOAD_ONLY=1 the system is loaded but quasar.app:main is not started;
# CI uses this to verify the real ASDF system compiles without running the
# server.
sbcl_args=(
  --non-interactive
  --eval '(setf asdf:*central-registry* nil)'
  --eval '(asdf:clear-configuration)'
  --eval '(ql:quickload (list :babel :bordeaux-threads :clack :clog :dexador :jsown :quri :sento :tek9 :websocket-driver) :silent t)'
  --eval '(asdf:load-asd (truename "systems/quasar-control.asd"))'
  --eval '(asdf:load-asd (truename "systems/quasar-starlang.asd"))'
  --eval '(asdf:load-asd (truename "systems/quasar-web.asd"))'
  --eval '(asdf:load-system :quasar-web)'
)

if [[ "${LOAD_ONLY:-0}" != "1" ]]; then
  sbcl_args+=(--eval '(quasar.app:main :open-browser-p nil :insecure-development-p t)')
fi

sbcl "${sbcl_args[@]}"
