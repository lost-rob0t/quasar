#!/usr/bin/env bash
# Install Quasar's git-pinned Common Lisp source dependencies into Quicklisp
# local-projects. This is the canonical CI/bootstrap path; callers should not
# duplicate these pins in workflow YAML.
set -euo pipefail

CLOG_SHA="9ee022a97ab4109f2ff6d2b9c43ba6da286d6302"
TEK9_SHA="ca24ef35ea6877420cbca057dd7fb702fe29a740"

local_projects="${QUASAR_QUICKLISP_LOCAL_PROJECTS:-$HOME/quicklisp/local-projects}"
tek9_path="${QUASAR_TEK9_PATH:-$HOME/starintel/tek9}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Nix exports the pinned Tek9 input without .git. Verify its lock/revision and
# full NAR hash before any dependency mutation; never clone into that source.
tek9_source_verified=0
if [[ -d "$tek9_path" && ! -e "$tek9_path/.git" ]]; then
  node "$repo_root/scripts/check-tek9-nix-source.mjs" "$tek9_path" "$TEK9_SHA"
  tek9_source_verified=1
fi
mkdir -p "$local_projects"

sync_dependency() {
  local name="$1"
  local url="$2"
  local sha="$3"
  local path="$4"

  if [[ ! -d "$path/.git" ]]; then
    mkdir -p "$(dirname "$path")"
    git clone --quiet "$url" "$path"
  else
    if ! git -C "$path" diff --quiet --ignore-submodules -- || \
       ! git -C "$path" diff --cached --quiet --ignore-submodules --; then
      echo "Refusing to overwrite dirty dependency checkout: $path" >&2
      exit 1
    fi
    git -C "$path" remote set-url origin "$url"
    git -C "$path" fetch --quiet origin
  fi

  if ! git -C "$path" cat-file -e "${sha}^{commit}" 2>/dev/null; then
    git -C "$path" fetch --quiet origin "$sha"
  fi
  git -C "$path" checkout --quiet --detach "$sha"

  local actual
  actual="$(git -C "$path" rev-parse HEAD)"
  if [[ "$actual" != "$sha" ]]; then
    echo "Dependency $name resolved to $actual, expected $sha" >&2
    exit 1
  fi
}

sync_dependency "clog" "https://github.com/rabbibotton/clog.git" "$CLOG_SHA" "$local_projects/clog"
if [[ "$tek9_source_verified" == "0" ]]; then
  sync_dependency "tek9" "https://github.com/lost-rob0t/tek9.git" "$TEK9_SHA" "$tek9_path"
fi

printf 'Pinned Common Lisp dependencies ready:\n  CLOG %s\n  Tek9 %s\n' \
  "$CLOG_SHA" "$TEK9_SHA"

# The canonical StarIntel validator is vendored and source-pinned with Quasar.
ln -sfn "$repo_root/vendor/star-cl" "$local_projects/quasar-starintel-canonical"
